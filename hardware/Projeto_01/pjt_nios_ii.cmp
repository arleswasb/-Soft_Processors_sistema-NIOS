	component pjt_nios_ii is
		port (
			clk_clk                 : in  std_logic                     := 'X';             -- clk
			reset_reset_n           : in  std_logic                     := 'X';             -- reset_n
			leds_export             : out std_logic_vector(9 downto 0);                     -- export
			chaves_export           : in  std_logic_vector(1 downto 0)  := (others => 'X'); -- export
			botao_start_stop_export : in  std_logic                     := 'X';             -- export
			display_7seg_export     : out std_logic_vector(13 downto 0)                     -- export
		);
	end component pjt_nios_ii;

